<launch>
  <arg name="model" default="waffle_pi" doc="model type [burger, waffle, waffle_pi]"/>
  <arg name="x_pos" default="0.8"/>
  <arg name="y_pos" default="-1.747"/>
  <arg name="z_pos" default="0.0"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find turtlebot3_gazebo)/worlds/turtlebot3_autorace_2020.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find turtlebot3_gui)/urdf/turtlebot3_waffle_pi_dual_cam.urdf.xacro" />
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_urdf" args="-urdf -model turtlebot3_$(arg model) -x $(arg x_pos) -y $(arg y_pos) -z $(arg z_pos) -param robot_description" />

  <!-- Узел для симуляции данных с сенсоров, включая энкодеры -->
  <node pkg="turtlebot3_gui" type="sensor_state_simulator.py" name="sensor_state_simulator" output="screen"/>

  <!-- Узлы обработки изображений с камер -->
  <node pkg="turtlebot3_gui" type="camera_processor.py" name="left_camera_processor" output="screen">
    <param name="camera_name" value="left_camera"/>
  </node>

  <node pkg="turtlebot3_gui" type="camera_processor.py" name="right_camera_processor" output="screen">
    <param name="camera_name" value="right_camera"/>
  </node>

  <!-- Запуск GUI приложения -->
  <node pkg="turtlebot3_gui" type="turtlebot_gui.py" name="turtlebot_gui" output="screen"/>
</launch>
