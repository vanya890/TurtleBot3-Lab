<?xml version="1.0"?>
<robot name="turtlebot3_waffle_pi_dual_cam" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Включаем базовую модель Waffle Pi -->
  <xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_waffle_pi.urdf.xacro"/>

  <!-- Добавляем левую камеру -->
  <link name="left_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.03 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.03 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0005"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Добавляем правую камеру -->
  <link name="right_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.03 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.03 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0005"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Совместная фикция для левой камеры -->
  <joint name="left_camera_joint" type="fixed">
    <origin xyz="0 0.064 0.032" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_camera_link"/>
  </joint>

  <!-- Совместная фикция для правой камеры -->
  <joint name="right_camera_joint" type="fixed">
    <origin xyz="0 -0.064 0.032" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_camera_link"/>
  </joint>

  <!-- Gazebo плагин для левой камеры -->
  <gazebo reference="left_camera_link">
    <material>Gazebo/BlackTransparent</material>
    <sensor type="camera" name="left_camera">
      <update_rate>30.0</update_rate>
      <camera name="left_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <plugin name="left_camera_controller" filename="libgazebo_ros_camera.so">
        <cameraName>left_camera</cameraName>
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <imageTopicName>/left_camera/image_raw</imageTopicName>
        <cameraInfoTopicName>/left_camera/camera_info</cameraInfoTopicName>
        <frameName>left_camera_link</frameName>
        <baseline>0.1</baseline>
        <distortion_k1>0.0</distortion_k1>
        <distortion_k2>0.0</distortion_k2>
        <distortion_k3>0.0</distortion_k3>
        <distortion_t1>0.0</distortion_t1>
        <distortion_t2>0.0</distortion_t2>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo плагин для правой камеры -->
  <gazebo reference="right_camera_link">
    <material>Gazebo/BlackTransparent</material>
    <sensor type="camera" name="right_camera">
      <update_rate>30.0</update_rate>
      <camera name="right_camera">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <plugin name="right_camera_controller" filename="libgazebo_ros_camera.so">
        <cameraName>right_camera</cameraName>
        <alwaysOn>true</alwaysOn>
        <updateRate>30.0</updateRate>
        <imageTopicName>/right_camera/image_raw</imageTopicName>
        <cameraInfoTopicName>/right_camera/camera_info</cameraInfoTopicName>
        <frameName>right_camera_link</frameName>
        <baseline>0.1</baseline>
        <distortion_k1>0.0</distortion_k1>
        <distortion_k2>0.0</distortion_k2>
        <distortion_k3>0.0</distortion_k3>
        <distortion_t1>0.0</distortion_t1>
        <distortion_t2>0.0</distortion_t2>
      </plugin>
    </sensor>
  </gazebo>

</robot>
